APP_PORT=
FRONTEND_PORT=
QDRANT_PORT=
# Base URL must include /v1 for OpenAI-compatible endpoints (Ollama, vLLM, etc.)
MODEL_ENDPOINT_URL=http://host.docker.internal:8001/v1
MODEL_ENDPOINT_API_KEY=
MODEL_REQUEST_TIMEOUT=
DESCRIPTION_MODEL=
# Base URL only — SDK appends /chat/completions. Trailing path causes 404.
DESCRIPTION_ENDPOINT_URL=
DESCRIPTION_ENDPOINT_API_KEY=
EMBEDDING_MODEL=
UPLOAD_API_KEY=
ADMIN_API_KEY=
# Google Drive sync — set both to enable; leave blank to disable.
DRIVE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=
DRIVE_SYNC_INTERVAL_SECONDS=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_VECTOR_SIZE=
QDRANT_DISTANCE=
# Required to use POST /v1/search. Minimum cosine similarity (0-1) for hits.
SEARCH_THRESHOLD=